{% extends 'base.html.twig' %}

{% block title %}Assuntos{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Assuntos</h1>
        <a href="{{ path('assunto_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Novo assunto</a>
    </div>

    <div class="card card-listagem shadow-sm">
        <div class="card-body">
            <form method="get" class="mb-3">
                <input type="hidden" name="porPagina" value="{{ porPagina }}">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="busca" value="{{ busca }}" class="form-control" placeholder="Buscar por descrição do assunto">
                </div>
            </form>

            {% if total == 0 %}
                {% if busca %}
                    <p class="text-muted mb-0">Nenhum resultado encontrado para “{{ busca }}”.</p>
                {% else %}
                    <p class="text-muted mb-0">Nenhum assunto cadastrado ainda.</p>
                {% endif %}
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Descrição</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for assunto in assuntos %}
                                <tr>
                                    <td>{{ assunto.codAs }}</td>
                                    <td>
                                        <a href="{{ path('assunto_show', {id: assunto.codAs}) }}" class="text-decoration-none">
                                            <span class="badge text-bg-secondary">{{ assunto.descricao }}</span>
                                        </a>
                                    </td>
                                    <td class="text-center">
                                        <a href="{{ path('assunto_show', {id: assunto.codAs}) }}" class="btn btn-icone btn-ver" title="Ver" aria-label="Ver"><i class="bi bi-eye"></i></a>
                                        <a href="{{ path('assunto_edit', {id: assunto.codAs}) }}" class="btn btn-icone btn-editar" title="Editar" aria-label="Editar"><i class="bi bi-pencil-square"></i></a>
                                        <form action="{{ path('assunto_delete', {id: assunto.codAs}) }}" method="post" class="d-inline" id="form-excluir-assunto-{{ assunto.codAs }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assunto.codAs) }}">
                                            <button type="button" class="btn btn-icone btn-excluir" data-bs-toggle="modal" data-bs-target="#modalExcluir" data-nome="o assunto “{{ assunto.descricao }}”" data-form="form-excluir-assunto-{{ assunto.codAs }}" title="Excluir" aria-label="Excluir"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {{ include('_paginacao.html.twig', {rota: 'assunto_index', paginaAtual: paginaAtual, porPagina: porPagina, total: total, totalPaginas: totalPaginas, busca: busca}) }}
            {% endif %}
        </div>
    </div>

    {{ include('_confirmar_exclusao.html.twig') }}
{% endblock %}
