{% extends 'base.html.twig' %}

{% block title %}Livros{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Livros</h1>
        <a href="{{ path('livro_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Novo livro</a>
    </div>

    <div class="card card-listagem shadow-sm">
        <div class="card-body">
            <form method="get" class="mb-3">
                <input type="hidden" name="porPagina" value="{{ porPagina }}">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="busca" value="{{ busca }}" class="form-control" placeholder="Buscar por título ou editora">
                </div>
            </form>

            {% if total == 0 %}
                {% if busca %}
                    <p class="text-muted mb-0">Nenhum resultado encontrado para “{{ busca }}”.</p>
                {% else %}
                    <p class="text-muted mb-0">Nenhum livro cadastrado ainda.</p>
                {% endif %}
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Título</th>
                                <th>Editora</th>
                                <th>Edição</th>
                                <th>Ano</th>
                                <th class="text-end">Valor</th>
                                <th>Autores</th>
                                <th>Assuntos</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for livro in livros %}
                                <tr>
                                    <td>{{ livro.codL }}</td>
                                    <td><a href="{{ path('livro_show', {id: livro.codL}) }}" class="link-tabela">{{ livro.titulo }}</a></td>
                                    <td>{{ livro.editora }}</td>
                                    <td>{{ livro.edicao }}</td>
                                    <td>{{ livro.anoPublicacao }}</td>
                                    <td class="text-end">{{ livro.valor|format_currency('BRL', locale='pt_BR') }}</td>
                                    <td>
                                        {% for autor in livro.autores %}
                                            <span class="badge text-bg-primary">{{ autor.nome }}</span>
                                        {% endfor %}
                                    </td>
                                    <td>
                                        {% for assunto in livro.assuntos %}
                                            <span class="badge text-bg-secondary">{{ assunto.descricao }}</span>
                                        {% endfor %}
                                    </td>
                                    <td class="text-center text-nowrap">
                                        <a href="{{ path('livro_show', {id: livro.codL}) }}" class="btn btn-icone btn-ver" title="Ver" aria-label="Ver"><i class="bi bi-eye"></i></a>
                                        <a href="{{ path('livro_edit', {id: livro.codL}) }}" class="btn btn-icone btn-editar" title="Editar" aria-label="Editar"><i class="bi bi-pencil-square"></i></a>
                                        <form action="{{ path('livro_delete', {id: livro.codL}) }}" method="post" class="d-inline" id="form-excluir-livro-{{ livro.codL }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ livro.codL) }}">
                                            <button type="button" class="btn btn-icone btn-excluir" data-bs-toggle="modal" data-bs-target="#modalExcluir" data-nome="o livro “{{ livro.titulo }}”" data-form="form-excluir-livro-{{ livro.codL }}" title="Excluir" aria-label="Excluir"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {{ include('_paginacao.html.twig', {rota: 'livro_index', paginaAtual: paginaAtual, porPagina: porPagina, total: total, totalPaginas: totalPaginas, busca: busca}) }}
            {% endif %}
        </div>
    </div>

    {{ include('_confirmar_exclusao.html.twig') }}
{% endblock %}
